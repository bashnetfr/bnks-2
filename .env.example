# EduFit Nepal — Environment Variables
# Copy this to .env.local and fill in your values.
# Never commit .env.local to git.

# Public — safe to expose in browser bundles
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — must NEVER reach the client
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NVIDIA_NIM_API_KEY=your-nvidia-nim-api-key

# Server-only — key required by /hq-control admin APIs (sent as x-admin-key header)
ADMIN_SECRET_KEY=choose-a-long-random-secret
